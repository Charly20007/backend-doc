<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Permite ejecutar con un runtime más nuevo (ej. .NET 10) si .NET 9 no está instalado -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.11" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Surgeon.Application\Surgeon.Application.csproj" />
    <ProjectReference Include="..\Surgeon.Infrastructure\Surgeon.Infrastructure.csproj" />
  </ItemGroup>

</Project>
